---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const pocs = await getCollection('pocs');
  return pocs.map((poc) => ({ params: { slug: poc.id }, props: { poc } }));
}
const { poc } = Astro.props;
const { Content } = await render(poc);
const categories = {
  'solutions-architecture': 'Solutions Architecture',
  'data-engineering': 'Data Engineering',
  'ml-engineering': 'ML Engineering',
  'ai-genai': 'AI / GenAI',
};
const base = `${import.meta.env.BASE_URL.replace(//$/, '')}/`;
---
<BaseLayout title={poc.data.title} description={poc.data.summary}>
  <article class="poc-page shell">
    <a class="back-link" href={`${base}#work`}><span aria-hidden="true">←</span> Back to selected work</a>
    <div class="poc-hero">
      <div class="poc-title-block"><p class="eyebrow">{categories[poc.data.category]} {poc.body?.includes('Placeholder PoC:') && <><span class="eyebrow-separator">/</span> <span class="placeholder-tag inline-tag">PLACEHOLDER POC</span></>}</p><h1>{poc.data.title}</h1><p class="poc-summary">{poc.data.summary}</p><div class="poc-links"><a class="button button-primary" href={poc.data.repoUrl} target="_blank" rel="noreferrer">View repository <span>↗</span></a><a class="text-link" href={poc.data.demoUrl} target="_blank" rel="noreferrer">Live demo <span>↗</span></a></div></div>
      <div class="poc-cover"><img src={`${base}${poc.data.image.replace(/^//, '')}`} alt={`Illustration for ${poc.data.title}`} /></div>
    </div>
    <div class="poc-meta"><div><span>DATE</span><strong>{poc.data.date.toLocaleDateString('en', { year: 'numeric', month: 'long' })}</strong></div><div><span>BUILT WITH</span><div class="tag-row">{poc.data.awsServices.map((service) => <span>{service}</span>)}</div></div></div>
    <div class="poc-body"><aside><p>PROJECT NOTES</p><span>A focused experiment exploring practical cloud patterns.</span></aside><div class="markdown-content"><Content /></div></div>
  </article>
</BaseLayout>
