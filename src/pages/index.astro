---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allPocs = await getCollection('pocs');
const categories = [
  { id: 'solutions-architecture', name: 'Solutions Architecture', number: '01', intro: 'Secure, resilient cloud foundations built around the way people and products actually work.' },
  { id: 'data-engineering', name: 'Data Engineering', number: '02', intro: 'Dependable data platforms that turn distributed information into usable insight.' },
  { id: 'ml-engineering', name: 'ML Engineering', number: '03', intro: 'Practical machine learning systems, from well-shaped data to observable deployment.' },
  { id: 'ai-genai', name: 'AI / GenAI', number: '04', intro: 'Useful generative AI experiences grounded in real workflows, retrieval, and responsible design.' },
];
const pocs = allPocs.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const certifications = [
  { mark: 'SA', name: 'AWS Certified Solutions Architect', level: 'Professional practice' },
  { mark: 'DE', name: 'AWS Certified Data Engineer', level: 'Data foundations' },
  { mark: 'ML', name: 'AWS Certified Machine Learning Engineer', level: 'Intelligent systems' },
  { mark: 'AI', name: 'AWS Certified AI Practitioner', level: 'Applied AI literacy' },
];
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<BaseLayout title="Cloud Solutions Architect & Data / ML Engineer" description="Dima Williams builds dependable AWS cloud platforms, data systems, and applied machine learning solutions.">
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot"></span> CLOUD · DATA · MACHINE LEARNING</p>
      <h1>Turning complex systems into <span class="gradient-text">clear outcomes.</span></h1>
      <p class="hero-lede">I’m Dima Williams — an AWS Solutions Architect and Data / ML Engineer designing cloud platforms and intelligent products that are built to last.</p>
      <p class="company-line"><a href="https://www.cloudheightsolutions.com/" target="_blank" rel="noreferrer">Cloud Heights Solutions Ltd <span aria-hidden="true">↗</span></a></p>
      <div class="hero-actions"><a class="button button-primary" href="#work">Explore selected work <span aria-hidden="true">↘</span></a><a class="text-link" href="#contact">Let’s connect <span aria-hidden="true">↗</span></a></div>
      <div class="hero-meta"><span><span class="meta-icon" aria-hidden="true">⌁</span> AWS-certified across cloud, data &amp; AI</span><span><span class="meta-icon" aria-hidden="true">◌</span> Architecture to deployment</span></div>
    </div>
    <div class="hero-art" aria-hidden="true">
      <div class="art-orbit orbit-one"></div><div class="art-orbit orbit-two"></div>
      <div class="art-node node-cloud"><span class="node-symbol">☁</span><span>Cloud</span></div>
      <div class="art-node node-data"><span class="node-symbol">◈</span><span>Data</span></div>
      <div class="art-node node-ml"><span class="node-symbol">✳</span><span>Intelligence</span></div>
      <div class="art-core"><span class="core-spark">✳</span><strong>Build<br />what’s next</strong><small>Cloud Heights</small></div>
      <span class="art-label label-top">DESIGN</span><span class="art-label label-bottom">DELIVER</span>
      <span class="art-particle particle-a"></span><span class="art-particle particle-b"></span><span class="art-particle particle-c"></span>
    </div>
  </section>

  <section class="cert-section shell" aria-labelledby="cert-title">
    <div class="section-kicker"><span>01 / CREDENTIALS</span><span class="kicker-line"></span></div>
    <div class="cert-heading"><h2 id="cert-title">Certified to go <span class="muted-text">deeper.</span></h2><p>Recognized across the AWS stack — from resilient architecture to applied AI.</p></div>
    <div class="cert-grid">
      {certifications.map((cert, index) => <article class="cert-card"><div class={`cert-emblem emblem-${index + 1}`}><span>{cert.mark}</span><svg viewBox="0 0 100 100" aria-hidden="true"><path d="M50 3 62 13 78 12 84 27 97 37 92 53 96 69 82 79 76 94 59 92 45 99 33 87 17 85 14 68 3 56 9 40 7 24 23 17 32 4Z"/></svg></div><div><p class="cert-label">AWS CERTIFIED</p><h3>{cert.name}</h3><p class="cert-level">{cert.level}</p></div><span class="cert-check" aria-hidden="true">✓</span></article>)}
    </div>
  </section>

  <section class="work-section" id="work">
    <div class="shell">
      <div class="section-kicker"><span>02 / SELECTED WORK</span><span class="kicker-line"></span></div>
      <div class="work-heading"><div><h2>Ideas, made <span class="gradient-text">tangible.</span></h2><p>Small, focused proofs of concept exploring real-world cloud and intelligent systems challenges.</p></div><span class="work-count">{String(pocs.length).padStart(2, '0')} PROJECTS <span class="count-dot"></span></span></div>
      <div class="category-list">
        {categories.map((category) => {
          const entries = pocs.filter((poc) => poc.data.category === category.id);
          return <section class="category-block" aria-labelledby={`category-${category.id}`}>
            <div class="category-title"><span class="category-number">{category.number}</span><div><h3 id={`category-${category.id}`}>{category.name}</h3><p>{category.intro}</p></div><span class="category-counter">{String(entries.length).padStart(2, '0')} <span>PoC{entries.length === 1 ? '' : 's'}</span></span></div>
            <div class="project-grid">
              {entries.map((poc) => <a class="project-card" href={`${base}pocs/${poc.id}/`}>
                <div class="project-image"><img src={`${base}${poc.data.image.replace(/^\//, '')}`} alt="" loading="lazy" />{poc.body?.includes('Placeholder PoC:') && <span class="placeholder-tag">PLACEHOLDER POC</span>}<span class="project-arrow" aria-hidden="true">↗</span></div>
                <div class="project-content"><p class="project-type">{category.name.toUpperCase()}</p><h4>{poc.data.title}</h4><p class="project-summary">{poc.data.summary}</p><div class="tag-row">{poc.data.awsServices.slice(0, 3).map((service) => <span>{service}</span>)}</div></div>
              </a>)}
            </div>
          </section>;
        })}
      </div>
    </div>
  </section>

  <section class="about-section shell" id="about">
    <div class="section-kicker"><span>03 / HOW I WORK</span><span class="kicker-line"></span></div>
    <div class="about-grid"><div><h2>Good engineering is <span class="gradient-text">felt.</span></h2></div><div class="about-copy"><p class="about-lede">It’s the right system, made understandable — and dependable long after launch.</p><p>At Cloud Heights Solutions Ltd, I bring architecture, data engineering, and machine learning together to solve the whole problem. I care about thoughtful trade-offs, secure foundations, and outcomes teams can measure and maintain.</p><div class="principle-list"><span><b>01</b> Start with the outcome</span><span><b>02</b> Design for real operations</span><span><b>03</b> Make complexity useful</span></div></div></div>
  </section>

  <section class="contact-section" id="contact"><div class="shell contact-inner"><div><p class="eyebrow">HAVE A CHALLENGE IN MIND?</p><h2>Let’s make your next<br /><span class="gradient-text">idea real.</span></h2></div><div class="contact-right"><p>Open to conversations about cloud architecture, data platforms, and applied AI.</p><div class="contact-links"><a href="mailto:williams.dima@gmail.com">Email <span>↗</span></a><a href="https://www.linkedin.com/in/dima-williams/" target="_blank" rel="noreferrer">LinkedIn <span>↗</span></a><a href="https://github.com/dimawill" target="_blank" rel="noreferrer">GitHub <span>↗</span></a></div></div></div></section>
</BaseLayout>
